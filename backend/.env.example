GCP_PROJECT_ID=your-google-cloud-project-id
GCP_LOCATION=YOUR_GCP_LOCATION
GCS_BUCKET=your-storage-bucket-name
FIREBASE_SECRET_NAME=firebase-service-account
AADHAAR_SECRET_NAME=aadhaar-encryption-key
ALLOWED_ORIGINS=http://localhost:5173

# Redis Cache (Google Cloud Memorystore)
# Get the IP from: gcloud redis instances describe ashaai-redis --region=asia-south1 --format="get(host)"
# Local development: leave empty to disable Redis (app falls back to Firestore)
REDIS_URL=
